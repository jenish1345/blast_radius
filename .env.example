# Copy to .env and fill in. Never commit .env.

# Nebius Token Factory — https://tokenfactory.nebius.com
# Same key is used for model inference AND for Sandboxes (ConTree).
NEBIUS_API_KEY=

# Tavily — https://app.tavily.com  (free tier: 1000 credits/month)
# Optional. Without it, premise checking is skipped and the run still works.
TAVILY_API_KEY=

# --- Everything below has working defaults. Only change if `make models` says so. ---

BR_BASE_URL=https://api.tokenfactory.nebius.com/v1/
BR_MODEL_AGENT=nvidia/nemotron-3-ultra-550b-a55b
BR_MODEL_INTENT=nvidia/nemotron-3-nano-30b
BR_MODEL_JUDGE=nvidia/nemotron-3-super-120b-a12b

# Base OCI image for sandboxes
BR_BASE_IMAGE=ubuntu:24.04

# Hard safety rails. A runaway loop against a 1M-context model is the only
# realistic way to burn $50 of credits. These stop that.
BR_MAX_TOKENS_PER_RUN=400000
BR_MAX_USD_PER_RUN=0.75
BR_MAX_STEPS=20

BR_DB_PATH=blastradius.db
